{
  "name": "agent-notify",
  "version": "1.0.0",
  "description": "Telegram notification & interactive human-in-the-loop CLI and MCP server for AI agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "agent-notify": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "telegram",
    "notifications",
    "ai-agent",
    "human-in-the-loop",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astinaam/agent-notify.git"
  },
  "author": "astinaam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/astinaam/agent-notify/issues"
  },
  "homepage": "https://github.com/astinaam/agent-notify#readme",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
